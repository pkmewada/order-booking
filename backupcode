<script src="assets/js/cutting-manager.js"></script>




$(document).ready(function() {
    // Batch data with quantities
    let batchData = [
        { id: 1, batchId: 'BATCH-001', designNumber: 'Frock', color: 'Red', quantity: 100 },
        { id: 2, batchId: 'BATCH-002', designNumber: 'Shirt', color: 'Blue', quantity: 150 },
        { id: 3, batchId: 'BATCH-003', designNumber: 'Pant', color: 'Green', quantity: 200 },
        { id: 4, batchId: 'BATCH-004', designNumber: 'Kurta', color: 'Yellow', quantity: 80 },
        { id: 5, batchId: 'BATCH-005', designNumber: 'Saree', color: 'Pink', quantity: 120 }
    ];

    let stitchedBatches = [];
    let cuttingData = [];
    let nextId = 1;
    let selectedSizes = [];
    let editingId = null;

    // Initialize
    populateBatchSelect();
    renderTable();

    // Populate batch select with remaining quantities
    function populateBatchSelect() {
        const select = $('#batchSelect');
        select.empty();
        select.append('<option value="">Choose Batch</option>');
        
        batchData.forEach(batch => {
            if (stitchedBatches.includes(batch.batchId)) return;
            
            const assigned = getAssignedQuantity(batch.batchId);
            const remaining = batch.quantity - assigned;
            const status = remaining === 0 ? '✅ Complete' : `${remaining} remaining`;
            select.append(`<option value="${batch.batchId}" data-remaining="${remaining}" data-total="${batch.quantity}">
                ${batch.batchId} - ${batch.designNumber} (${status})
            </option>`);
        });
    }

    // Get assigned quantity for a batch
    function getAssignedQuantity(batchId) {
        let total = 0;
        cuttingData.forEach(item => {
            if (item.batch === batchId && !item.passedToStitching) {
                total += parseInt(item.quantity);
            }
        });
        return total;
    }

    // Get completed quantity for a batch
    function getCompletedQuantity(batchId) {
        let total = 0;
        cuttingData.forEach(item => {
            if (item.batch === batchId && !item.passedToStitching) {
                total += parseInt(item.completed || 0);
            }
        });
        return total;
    }

    // Get remaining quantity for a batch
    function getRemainingQuantity(batchId) {
        const batch = batchData.find(b => b.batchId === batchId);
        if (!batch) return 0;
        const assigned = getAssignedQuantity(batchId);
        return batch.quantity - assigned;
    }

    // Check if batch is complete
    function isBatchComplete(batchId) {
        return getRemainingQuantity(batchId) === 0;
    }

    // Render table
    function renderTable() {
        const tbody = $('#cuttingMastersList');
        tbody.empty();

        if (cuttingData.length === 0) {
            tbody.append(`
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        <i class="bx bx-info-circle me-2"></i>No cutting assignments yet.
                    </td>
                </tr>
            `);
            return;
        }

        cuttingData.forEach((item, index) => {
            if (item.passedToStitching) return;
            
            const priorityClass = item.priority === 'High' ? 'text-danger' : 
                                 item.priority === 'Medium' ? 'text-warning' : 'text-secondary';
            
            const completed = item.completed || 0;
            const remaining = item.quantity - completed;
            const progressPercent = item.quantity > 0 ? (completed / item.quantity) * 100 : 0;
            
            let status = 'Pending';
            let statusClass = 'text-warning';
            
            if (completed === item.quantity) {
                status = '✅ Complete';
                statusClass = 'text-success';
            } else if (completed > 0) {
                status = 'In Progress';
                statusClass = 'text-primary';
            }
            
            tbody.append(`
                <tr>
                    <td>${index + 1}</td>
                    <td><span class="fw-semibold">${item.batch}</span></td>
                    <td>${item.worker}</td>
                    <td><span class="badge bg-secondary">${item.size}</span></td>
                    <td>${item.quantity}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span>${completed}</span>
                            <div class="progress-bar-container">
                                <div class="progress-bar-fill" style="width: ${progressPercent}%;"></div>
                            </div>
                        </div>
                    </td>
                    <td>${remaining}</td>
                    <td><span class="${priorityClass} fw-semibold">${item.priority}</span></td>
                    <td><span class="${statusClass} fw-semibold">${status}</span></td>
                    <td>
                        <button class="btn btn-sm btn-primary progress-btn" data-id="${item.id}" title="Update Progress">
                            <i class="bx bx-edit"></i>
                        </button>
                        ${remaining === 0 ? `
                            <button class="btn btn-sm btn-success pass-stitching-btn" data-batch="${item.batch}" title="Pass to Stitching">
                                <i class="bx bx-right-arrow-alt"></i>
                            </button>
                        ` : ''}
                        <button class="btn btn-sm btn-danger delete-btn" data-id="${item.id}" title="Delete">
                            <i class="bx bx-trash"></i>
                        </button>
                    </td>
                </tr>
            `);
        });
    }

    // Show assign modal
    $('#assignCuttingBtn').click(function() {
        resetModal();
        $('#assignModal').modal('show');
        populateBatchSelect();
        $('#batchRemaining').hide();
        selectedSizes = [];
        $('#sizeList').html('<small class="text-muted">Click "Add Size" to add multiple sizes</small>');
        $('#quantitySection').hide();
    });

    // Reset modal
    function resetModal() {
        $('#assignForm')[0].reset();
        $('#assignQty').val('');
        $('#remainingQtyDisplay').text('0');
        $('#maxQtyDisplay').text('0');
        selectedSizes = [];
        $('#quantityInputs').empty();
        $('#totalQuantityDisplay').text('0');
        editingId = null;
    }

    // Batch selection change
    $('#batchSelect').change(function() {
        const selected = $(this).find(':selected');
        const batchId = selected.val();
        
        if (batchId) {
            const remaining = parseInt(selected.data('remaining')) || 0;
            
            $('#remainingQtyDisplay').text(remaining);
            $('#batchRemaining').show();
            updateQuantityInputs();
        } else {
            $('#batchRemaining').hide();
        }
    });

    // Add size
    $('#addSizeBtn').click(function() {
        const size = $('#sizeSelect').val();
        if (!size) {
            Swal.fire({
                icon: 'warning',
                title: 'Select Size',
                text: 'Please select a size first.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        if (selectedSizes.includes(size)) {
            Swal.fire({
                icon: 'warning',
                title: 'Size Already Added',
                text: `Size ${size} is already added.`,
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        selectedSizes.push(size);
        renderSizeTags();
        $('#sizeSelect').val('');
        updateQuantityInputs();
        $('#quantitySection').show();
    });

    // Render size tags
    function renderSizeTags() {
        const container = $('#sizeList');
        container.empty();

        if (selectedSizes.length === 0) {
            container.html('<small class="text-muted">Click "Add Size" to add multiple sizes</small>');
            return;
        }

        selectedSizes.forEach(size => {
            container.append(`
                <span class="size-tag">
                    ${size}
                    <span class="remove-size" data-size="${size}">×</span>
                </span>
            `);
        });

        $('.remove-size').click(function() {
            const size = $(this).data('size');
            selectedSizes = selectedSizes.filter(s => s !== size);
            renderSizeTags();
            updateQuantityInputs();
            if (selectedSizes.length === 0) {
                $('#quantitySection').hide();
            }
        });
    }

    // Update quantity inputs
    function updateQuantityInputs() {
        const container = $('#quantityInputs');
        container.empty();

        if (selectedSizes.length === 0) {
            $('#totalQuantityDisplay').text('0');
            return;
        }

        const batchId = $('#batchSelect').val();
        const remaining = batchId ? parseInt($('#batchSelect').find(':selected').data('remaining')) || 0 : 0;
        
        // Distribute quantity evenly
        const baseQty = Math.floor(remaining / selectedSizes.length);
        const extra = remaining % selectedSizes.length;

        selectedSizes.forEach((size, index) => {
            let qty = baseQty;
            if (index < extra) qty += 1;
            
            container.append(`
                <div class="row mb-2">
                    <div class="col-4">
                        <strong>${size}</strong>
                    </div>
                    <div class="col-8">
                        <input type="number" class="form-control size-qty" data-size="${size}" value="${qty}" min="0" max="${remaining}">
                    </div>
                </div>
            `);
        });

        // Add event listeners for quantity changes
        $('.size-qty').on('input', function() {
            validateQuantities();
        });

        validateQuantities();
    }

    // Validate quantities
    function validateQuantities() {
        const batchId = $('#batchSelect').val();
        const remaining = batchId ? parseInt($('#batchSelect').find(':selected').data('remaining')) || 0 : 0;
        
        let total = 0;
        $('.size-qty').each(function() {
            const val = parseInt($(this).val()) || 0;
            total += val;
        });

        $('#totalQuantityDisplay').text(total);

        if (total === 0) {
            $('#quantityStatus').html('').removeClass('text-success text-danger');
            return;
        }

        if (total === remaining) {
            $('#quantityStatus').html('<span class="text-success">✅ Matches available quantity</span>');
        } else if (total < remaining) {
            $('#quantityStatus').html(`<span class="text-warning">⚠️ ${remaining - total} remaining to assign</span>`);
        } else {
            $('#quantityStatus').html(`<span class="text-danger">❌ Exceeds available by ${total - remaining}</span>`);
        }
    }

    // Save Assignment
    $('#saveAssignBtn').click(function() {
        const batchId = $('#batchSelect').val();
        const worker = $('#workerSelect').val();
        const priority = $('#prioritySelect').val();

        if (!batchId) {
            Swal.fire({
                icon: 'warning',
                title: 'Select Batch',
                text: 'Please select a batch.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        if (!worker) {
            Swal.fire({
                icon: 'warning',
                title: 'Select Worker',
                text: 'Please select a worker.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        if (selectedSizes.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Add Sizes',
                text: 'Please add at least one size.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        if (!priority) {
            Swal.fire({
                icon: 'warning',
                title: 'Select Priority',
                text: 'Please select a priority.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        // Get quantities for each size
        let sizeQuantities = {};
        let totalQty = 0;
        let isValid = true;
        let errorMessage = '';

        $('.size-qty').each(function() {
            const size = $(this).data('size');
            const qty = parseInt($(this).val()) || 0;
            sizeQuantities[size] = qty;
            totalQty += qty;
        });

        const remaining = parseInt($('#batchSelect').find(':selected').data('remaining')) || 0;

        if (totalQty === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Invalid Quantity',
                text: 'Please assign at least 1 piece.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        if (totalQty > remaining) {
            Swal.fire({
                icon: 'warning',
                title: 'Exceeds Available',
                text: `Total quantity (${totalQty}) exceeds available (${remaining}).`,
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        // Show confirmation
        let message = `Worker: ${worker}\nBatch: ${batchId}\n\nQuantity Distribution:\n`;
        for (let size in sizeQuantities) {
            if (sizeQuantities[size] > 0) {
                message += `${size}: ${sizeQuantities[size]} pieces\n`;
            }
        }
        message += `\nTotal: ${totalQty} pieces`;
        message += `\nRemaining: ${remaining - totalQty} pieces`;

        Swal.fire({
            title: 'Confirm Assignment',
            text: message,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Confirm',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                // Save each size assignment
                for (let size in sizeQuantities) {
                    const qty = sizeQuantities[size];
                    if (qty > 0) {
                        cuttingData.push({
                            id: nextId++,
                            batch: batchId,
                            worker: worker,
                            size: size,
                            quantity: qty,
                            priority: priority,
                            completed: 0,
                            passedToStitching: false
                        });
                    }
                }

                renderTable();
                populateBatchSelect();
                $('#assignModal').modal('hide');
                
                Swal.fire({
                    icon: 'success',
                    title: 'Assigned!',
                    text: `Worker ${worker} assigned ${totalQty} pieces across ${selectedSizes.length} size(s).`,
                    timer: 3000,
                    showConfirmButton: false
                });
            }
        });
    });

    // Progress button
    $(document).on('click', '.progress-btn', function() {
        const id = parseInt($(this).data('id'));
        const item = cuttingData.find(d => d.id === id);
        if (!item) return;

        editingId = id;
        $('#progressWorker').val(item.worker);
        $('#progressBatch').val(item.batch);
        $('#progressSize').val(item.size);
        $('#progressAssigned').val(item.quantity);
        $('#progressMax').text(item.quantity);
        $('#progressCompleted').val(item.completed || 0);
        $('#progressModal').modal('show');
    });

    // Update Progress
    $('#updateProgressBtn').click(function() {
        const completed = parseInt($('#progressCompleted').val()) || 0;
        const max = parseInt($('#progressMax').text()) || 0;

        if (completed < 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Invalid Input',
                text: 'Completed quantity cannot be negative.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        if (completed > max) {
            Swal.fire({
                icon: 'warning',
                title: 'Exceeds Assigned',
                text: `Completed quantity (${completed}) cannot exceed assigned (${max}).`,
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        const item = cuttingData.find(d => d.id === editingId);
        if (item) {
            item.completed = completed;
            renderTable();
            $('#progressModal').modal('hide');
            
            Swal.fire({
                icon: 'success',
                title: 'Updated!',
                text: `Progress updated to ${completed}/${item.quantity} pieces.`,
                timer: 2000,
                showConfirmButton: false
            });
        }
    });

    // Pass to Stitching button
    $(document).on('click', '.pass-stitching-btn', function() {
        const batchId = $(this).data('batch');
        const batch = batchData.find(b => b.batchId === batchId);
        if (!batch) return;

        const completed = getCompletedQuantity(batchId);
        const assigned = getAssignedQuantity(batchId);

        if (completed < assigned) {
            Swal.fire({
                icon: 'warning',
                title: 'Incomplete Work',
                text: `Only ${completed}/${assigned} pieces completed. Please complete all before passing.`,
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        $('#passBatchId').val(batchId);
        $('#passTotalQty').val(batch.quantity);
        $('#passCompletedQty').val(completed);
        $('#passStitchingModal').modal('show');
    });

    // Confirm Pass to Stitching
    $('#confirmPassBtn').click(function() {
        const batchId = $('#passBatchId').val();
        
        cuttingData.forEach(item => {
            if (item.batch === batchId) {
                item.passedToStitching = true;
            }
        });

        if (!stitchedBatches.includes(batchId)) {
            stitchedBatches.push(batchId);
        }

        renderTable();
        populateBatchSelect();
        $('#passStitchingModal').modal('hide');

        Swal.fire({
            icon: 'success',
            title: 'Passed to Stitching!',
            text: `Batch ${batchId} has been passed to stitching successfully.`,
            timer: 3000,
            showConfirmButton: false
        });
    });

    // Delete button
    $(document).on('click', '.delete-btn', function() {
        const id = parseInt($(this).data('id'));
        const item = cuttingData.find(d => d.id === id);
        if (!item) return;

        Swal.fire({
            title: 'Are you sure?',
            html: `You are about to delete assignment for <strong>${item.worker}</strong> (${item.size}) from ${item.batch}`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                cuttingData = cuttingData.filter(d => d.id !== id);
                renderTable();
                populateBatchSelect();
                
                Swal.fire({
                    icon: 'success',
                    title: 'Deleted!',
                    text: 'Assignment has been deleted.',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        });
    });

    // Modal close handlers
    $('#assignModal').on('hidden.bs.modal', function() {
        resetModal();
    });

    $('#progressModal').on('hidden.bs.modal', function() {
        editingId = null;
    });

    // Initial render
    renderTable();
});